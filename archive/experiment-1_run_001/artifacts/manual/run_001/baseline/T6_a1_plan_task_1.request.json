        ]
      },
      {
        "id": "split",
        "description": "Train/test split of row indices with the run seed, optionally stratified on the target.",
        "default_selected": true,
        "params": {
          "test_size": {
            "description": "Share of rows held out for testing.",
            "options": [
              0.2,
              0.25,
              0.3
            ],
            "default": 0.25
          },
          "stratify": {
            "description": "Whether the split preserves the target's class balance in both partitions.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "split",
            "shape": "{test_size: float, stratify: bool, seed: int, n_train: int, n_test: int, prevalence_train: float, prevalence_test: float}"
          }
        ]
      },
      {
        "id": "preprocessing",
        "description": "One-hot encode categoricals and optionally scale numerics, fitted on a chosen partition.",
        "default_selected": true,
        "params": {
          "fit_on": {
            "description": "Which rows the encoder and scaler are fitted on.",
            "options": [
              "train_only",
              "all_data"
            ],
            "default": "all_data"
          },
          "scaling": {
            "description": "Whether numeric features are standardised.",
            "options": [
              "none",
              "standard"
            ],
            "default": "none"
          }
        },
        "produces": [
          {
            "key": "preprocessing",
            "shape": "{fit_on: str, scaling: str, n_features_out: int}"
          }
        ]
      },
      {
        "id": "models",
        "description": "Fit the chosen classifiers and report held-out metrics at threshold 0.5.",
        "default_selected": true,
        "params": {
          "models": {
            "description": "Which classifiers to train.",
            "multi": true,
            "options": [
              "logistic_regression",
