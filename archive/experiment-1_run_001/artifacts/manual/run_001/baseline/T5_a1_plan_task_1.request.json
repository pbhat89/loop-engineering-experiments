  "instructions": "Produce an analysis plan for this task by selecting components from the catalogue and setting their parameters. Use only catalogue component ids and declared parameter options; omitted parameters take their defaults. Deterministic code executes the plan exactly as written, and the result is scored against a frozen rubric (correctness, completeness, reproducibility, statistical discipline, communication) and a frozen golden reference. List in skills_applied the ids of any provided skills you actually used.",
  "payload": {
    "task_id": "T5",
    "condition": "baseline",
    "task_spec": {
      "task_id": "T5",
      "title": "Fraud-pattern exploration",
      "objective": "Explore how claims flagged by the synthetic fraud label differ from unflagged claims. Report class prevalence and the imbalance between the classes with counts. Compare the two groups on claim-level features that would be legitimately available and are not derived from the label itself: for categorical features give value shares in each group, for numeric features give means and medians. Do not use any field that encodes the label, and do not use member demographic or protected attributes (sex, race or ethnicity, age band) to characterise or target claims. Include an explicit leakage assessment that names label-derived fields, identifier fields and protected attributes and whether any appear in your comparison. State that the label is synthetic and imbalanced, that differences are associations rather than causes, and that nothing here is fit for operational use.",
      "tags": [
        "fraud",
        "exploration",
        "class_imbalance",
        "leakage",
        "protected_attributes",
        "comparison",
        "prevalence"
      ],
      "input_tables": [
        "medical_claims",
        "members"
      ],
      "required_artifacts": [
        "fraud_comparison.csv",
        "fraud_prevalence.png",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "load_tables",
        "description": "Load the task's input tables with the project dtype policy and record row and column counts.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "tables",
            "shape": "{table: {rows: int, columns: int}}"
          }
        ]
      },
      {
        "id": "class_prevalence",
        "description": "Positive and negative counts of the fraud label with prevalence and imbalance ratio.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "class_prevalence",
            "shape": "{positives: int, negatives: int, total: int, prevalence: float, imbalance_ratio: float}"
          }
        ],
        "artifacts": [
          "fraud_prevalence.png"
        ]
      },
      {
        "id": "feature_comparison",
        "description": "Per-feature comparison of flagged versus unflagged claims (shares for categorical, mean and median for numeric).",
        "default_selected": true,
        "params": {
          "features": {
            "description": "Which claim-level (or member-joined) features to compare between flagged and unflagged claims.",
            "multi": true,
            "options": [
              "claim_type",
              "cpt_category",
              "place_of_service",
              "provider_specialty",
              "network_status",
              "billed_amount",
              "allowed_amount",
              "paid_amount",
              "service_units",
              "length_of_stay",
              "er_flag",
              "auth_required_flag",
              "fraud_pattern_type",
              "high_cost_flag",
              "member_sex",
              "member_race_ethnicity",
              "member_age_band",
              "member_payer_type"
            ],
            "default": [
              "claim_type",
              "billed_amount",
              "fraud_pattern_type"
            ]
          }
        },
        "produces": [
          {
            "key": "feature_comparison",
            "shape": "{feature: {kind: categorical|numeric, n_flagged: int, n_unflagged: int, flagged: {value: share} | {mean, median}, unflagged: {value: share} | {mean, median}}} (member_* via m:1 join on member_id)"
          }
        ],
        "artifacts": [
          "fraud_comparison.csv"
        ]
      },
      {
        "id": "leakage_assessment",
        "description": "List label-derived fields, identifier fields and protected attributes and flag any that the plan uses.",
        "default_selected": false,
        "params": {},
        "produces": [
          {
            "key": "leakage_risks",
            "shape": "{label_derived_fields: [str], id_fields: [str], protected_attributes: [str], flagged_in_plan: [str]}"
          }
        ]
      },
      {
        "id": "write_report",
        "description": "Write report.md with summary, results, artifacts, caveats and method sections.",
        "default_selected": true,
        "params": {
