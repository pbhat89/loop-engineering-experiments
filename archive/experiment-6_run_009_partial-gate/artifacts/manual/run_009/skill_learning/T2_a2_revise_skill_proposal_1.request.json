    "proposal": {
      "name": "Compute denial rates over adjudicated claims",
      "tags": [
        "rates",
        "denominators",
        "correctness",
        "statistical_discipline"
      ],
      "trigger": "When measuring denial rate from claims data, ensure the denominator is statistically correct by using only claims that have completed adjudication.",
      "objective": "Ensure denial rates are computed over adjudicated claims (Paid, Denied, Adjusted) to exclude pending claims and yield statistically correct rates that demonstrate statistical discipline and reproducibility.",
      "procedure": [
        "Identify the claim_status column and enumerate its distinct values to confirm the presence of Paid, Denied, Adjusted, and Pended statuses.",
        "Define adjudicated claims as those with claim_status in {Paid, Denied, Adjusted}, excluding Pended and other interim statuses.",
        "Filter the claims dataset to only adjudicated claims using this status criterion.",
        "Count denied claims (claim_status == 'Denied') as the numerator of the denial rate.",
        "Count the total adjudicated claims (filtered set) as the denominator.",
        "Compute denial rate as numerator / denominator.",
        "Record in the metric output: numerator (count of Denied), denominator (count of adjudicated claims), numerator_definition (string describing Denied filter), denominator_definition (string describing Adjudicated definition), and denominator_option ('adjudicated_claims') to ensure clarity and reproducibility."
      ],
      "required_checks": [
        "Denominator includes only claims with status in {Paid, Denied, Adjusted} and excludes Pended.",
        "Numerator is count of claims with claim_status == 'Denied'.",
        "Denominator count in metric is total of filtered adjudicated claims.",
        "denominator_option in metric is recorded as 'adjudicated_claims'.",
        "numerator_definition and denominator_definition are present and descriptive."
      ],
      "expected_artifacts": [],
      "failure_modes": [
        "Using all_claims as denominator, which includes Pended claims not yet decided and understates the true denial rate.",
        "Using only Paid and Denied statuses in denominator, which excludes Adjusted claims and biases the rate.",
        "Failing to record the denominator_option field, preventing clarity and downstream use of the metric."
      ],
      "example": "",
      "applicable_task_ids": [
        "T3",
        "T4"
      ],
      "source_feedback_ids": [
