    "task_spec": {
      "task_id": "T4",
      "title": "Denial analysis",
      "objective": "The denials team wants to know why claims are being denied and where. Which denial reason codes are most common and what share of denials does each account for? How many claims carry no denial code at all? How does the denial rate differ by claim type, provider specialty, network status, place of service and whether prior authorisation was required? Produce the standard artifacts (denial code ranking table, denial rate by segment table and chart, report).",
      "tags": [
        "denials",
        "denial_codes",
        "rates",
        "denominators",
        "segments",
        "small_groups",
        "missingness"
      ],
      "input_tables": [
        "medical_claims"
      ],
      "required_artifacts": [
        "denial_code_ranking.csv",
        "denial_rates_by_segment.csv",
        "denial_rate_by_segment.png",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "load_tables",
        "description": "Load the task's input tables with the project dtype policy and record row and column counts.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "tables",
            "shape": "{table: {rows: int, columns: int}}"
          }
        ]
      },
      {
        "id": "denial_code_ranking",
        "description": "Frequency ranking of denial codes with shares over a chosen scope and a quantification of missing codes.",
        "default_selected": true,
        "params": {
          "scope": {
            "description": "Which claims form the base for each code's share (denied claims only, or all claims).",
            "options": [
              "denied_claims",
              "all_claims"
            ],
            "default": "all_claims"
          },
          "quantify_missing": {
            "description": "How to quantify missing denial codes (not at all, overall and among denied, or additionally by claim status).",
            "options": [
              "none",
              "overall",
              "by_status"
            ],
            "default": "overall"
          }
        },
        "produces": [
          {
            "key": "denial_code_ranking",
            "shape": "{scope: str, codes: [{code: str, n: int, share: float}], missing_denial_codes: {definition: str, overall: int, overall_denominator: int, among_denied: int, among_denied_denominator: int, by_status?: {status: {missing: int, n: int}}}}"
          }
        ],
        "artifacts": [
          "denial_code_ranking.csv"
        ]
      },
      {
        "id": "denial_rate_by_segment",
        "description": "Denial rate per value of chosen segment columns with numerator, denominator and small-group flags.",
        "default_selected": true,
        "params": {
          "segments": {
            "description": "Which claim-level columns to segment the denial rate by.",
            "multi": true,
            "options": [
              "claim_type",
              "provider_specialty",
              "network_status",
              "place_of_service",
              "auth_required_flag"
            ],
            "default": [
              "claim_type"
            ]
          },
          "denominator": {
            "description": "Which claims in each segment form the denominator.",
            "options": [
              "all_claims",
              "adjudicated_claims"
            ],
            "default": "all_claims"
          },
          "min_group_size": {
            "description": "Segment values with fewer claims than this are flagged as small (0 never flags).",
            "options": [
              0,
              30,
              50,
              100
            ],
            "default": 0
          }
        },
        "produces": [
          {
            "key": "denial_rate_by_segment",
            "shape": "{denominator_option: str, min_group_size: int, segments: {segment: {value: {numerator: int, denominator: int, rate: float, small_group_flag: bool}}}} (segment values keyed by their string form)"
          }
        ],
        "artifacts": [
          "denial_rates_by_segment.csv",
          "denial_rate_by_segment.png"
        ]
      },
      {
        "id": "write_report",
        "description": "Write report.md with summary, results, artifacts, caveats and method sections.",
        "default_selected": true,
        "params": {
          "caveats": {
            "description": "Which fixed caveat statements to include in the report's Caveats section.",
            "multi": true,
            "options": [
              "synthetic_data",
              "sample_preview",
              "descriptive_only",
              "association_not_causation",
              "small_groups",
              "class_imbalance",
              "model_limitations",
              "no_operational_use"
            ],
            "default": []
          },
          "show_denominators": {
            "description": "Whether every rate in the report is printed as numerator / denominator = rate.",
            "options": [
              true,
              false
            ],
            "default": false
          },
          "cite_artifacts": {
            "description": "Whether every results bullet ends with a [source: ...] reference to an artifact or metrics key.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "report",
            "shape": "{caveats: [str], show_denominators: bool, cite_artifacts: bool, sections: [str]}"
          }
        ],
