{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "schema_summary"
    },
    {
      "component": "missingness",
      "params": {
        "scope": "all_columns"
      }
    },
    {
      "component": "duplicate_check",
      "params": {
        "keys": [
          "medical_claims.claim_id",
          "pharmacy_claims.rx_claim_id",
          "members.member_id",
          "providers.provider_npi",
          "adherence.member_id+therapeutic_class"
        ]
      }
    },
    {
      "component": "date_ranges",
      "params": {
        "columns": [
          "medical_claims.service_date_from",
          "medical_claims.service_date_to",
          "medical_claims.adjudication_date",
          "pharmacy_claims.fill_date",
          "pharmacy_claims.paid_date",
          "pharmacy_claims.end_date",
          "members.enrollment_start",
          "members.enrollment_end"
        ],
        "consistency_checks": true
      }
    },
    {
      "component": "join_check",
      "params": {
        "pairs": [
          "medical_claims.member_id->members.member_id",
          "medical_claims.rendering_npi->providers.provider_npi",
          "medical_claims.billing_npi->providers.provider_npi",
          "pharmacy_claims.member_id->members.member_id",
          "pharmacy_claims.pharmacy_npi->providers.provider_npi",
          "pharmacy_claims.prescriber_npi->providers.provider_npi",
          "adherence.member_id->members.member_id"
        ]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [
          "descriptive_only",
          "small_groups"
        ],
        "show_denominators": true,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Comprehensive reconnaissance plan addressing all task requirements: basic structure via load_tables and schema_summary; data quality via missingness (all columns to catch the many nulls in medical_claims); identifier trustworthiness via duplicate_check on all candidate keys including composite key for adherence; temporal coverage via date_ranges on all date columns with consistency checks to detect claim anomalies; relationship verification via join_check on all seven cross-table pairs to identify the known pharmacy-provider non-match issue; report production with transparency caveats and artifact citations."
}
