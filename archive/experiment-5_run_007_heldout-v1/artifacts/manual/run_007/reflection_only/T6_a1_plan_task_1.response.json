        "scaling": "standard"
      }
    },
    {
      "component": "models",
      "params": {
        "models": [
          "logistic_regression",
          "random_forest"
        ],
        "class_weight": "balanced"
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [
          "class_imbalance",
          "model_limitations"
        ],
        "show_denominators": false,
        "cite_artifacts": false
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Baseline feature set excludes sparse/potentially-leaky fields (fraud_pattern_type is 95% null) and identifiers; focuses on claim attributes available at processing time. Stratified split preserves fraud class balance. Train-only preprocessing prevents data leakage. Standard scaling benefits logistic regression. Balanced class weights address the imbalance inherent in fraud detection."
