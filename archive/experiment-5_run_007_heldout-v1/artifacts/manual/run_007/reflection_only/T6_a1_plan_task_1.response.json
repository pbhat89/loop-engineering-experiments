{
  "steps": [
    {
      "component": "load_tables",
      "params": {}
    },
    {
      "component": "feature_set",
      "params": {
        "features": [
          "claim_type",
          "cpt_category",
          "place_of_service",
          "provider_specialty",
          "network_status",
          "billed_amount",
          "allowed_amount",
          "paid_amount",
          "service_units",
          "er_flag",
          "high_cost_flag",
          "auth_required_flag"
        ]
      }
    },
    {
      "component": "split",
      "params": {
