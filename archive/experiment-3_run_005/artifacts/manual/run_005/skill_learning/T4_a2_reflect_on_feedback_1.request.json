              "class_imbalance",
              "model_limitations",
              "no_operational_use"
            ],
            "default": []
          },
          "show_denominators": {
            "description": "Whether every rate in the report is printed as numerator / denominator = rate.",
            "options": [
              true,
              false
            ],
