  "instructions": "The previous plan was executed and evaluated; the evaluation summary, the feedback items and (when provided) a reflection are included. Return a complete revised plan - not a diff - that addresses the feedback, and summarise what changed in changes_summary.",
  "payload": {
    "task_id": "T13",
    "condition": "feedback_memory",
    "task_spec": {
      "task_id": "T13",
      "title": "Brief for the CFO",
      "objective": "Write a one-page brief (no more than 600 words) for the chief financial officer using only the saved results of the two tasks just completed in this set — the portfolio deep-dive and the wider-net high-cost model. Cover the key findings, how the model performed, the limitations and what to do next. Produce the standard artifacts (executive brief, findings table, report).",
      "tags": [
        "communication",
        "executive_brief",
        "traceability",
        "caveats",
        "synthesis",
        "limitations"
      ],
      "input_tables": [],
      "required_artifacts": [
        "executive_brief.md",
        "findings.json",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "collect_findings",
        "description": "Extract headline metrics from the final attempt of chosen source tasks under the same run and condition; missing sources are recorded, never invented.",
        "default_selected": true,
        "params": {
          "sources": {
            "description": "Which earlier tasks' saved metrics feed the brief.",
            "multi": true,
            "options": [
              "T11",
              "T12"
            ],
            "default": [
              "T11"
            ]
          }
        },
        "produces": [
          {
            "key": "findings",
            "shape": "[{task_id: str, metric_key: str, label: str, value, numerator?: int, denominator?: int, source_path: str}] or {task_id, status: missing}"
          }
        ],
        "artifacts": [
          "findings.json"
        ]
      },
      {
        "id": "brief_sections",
        "description": "Compose executive_brief.md from the collected findings with chosen sections, language style and citation policy.",
        "default_selected": true,
        "params": {
          "sections": {
            "description": "Which sections the brief contains.",
            "multi": true,
            "options": [
              "key_findings",
              "model_results",
              "limitations",
              "synthetic_caveats",
              "next_steps",
              "methodology"
            ],
            "default": [
              "key_findings",
              "model_results"
            ]
          },
          "causal_language": {
            "description": "Whether the brief may phrase relationships causally (\"X drives Y\") or only associatively (\"X is associated with Y\").",
            "options": [
              "avoid",
              "allow"
            ],
            "default": "allow"
          },
          "cite_artifacts": {
            "description": "Whether every numeric statement ends with a [source: <path>] citation.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "brief",
            "shape": "{sections: [str], causal_language: str, cite_artifacts: bool, word_count: int, n_numeric_statements: int, n_cited_statements: int}"
          }
        ],
        "artifacts": [
          "executive_brief.md"
        ]
      },
      {
        "id": "write_report",
        "description": "Write report.md with summary, results, artifacts, caveats and method sections.",
        "default_selected": true,
        "params": {
          "caveats": {
            "description": "Which fixed caveat statements to include in the report's Caveats section.",
            "multi": true,
            "options": [
              "synthetic_data",
              "sample_preview",
              "descriptive_only",
              "association_not_causation",
              "small_groups",
              "class_imbalance",
              "model_limitations",
              "no_operational_use"
            ],
            "default": []
          },
          "show_denominators": {
            "description": "Whether every rate in the report is printed as numerator / denominator = rate.",
            "options": [
              true,
              false
            ],
            "default": false
          },
          "cite_artifacts": {
            "description": "Whether every results bullet ends with a [source: ...] reference to an artifact or metrics key.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "report",
            "shape": "{caveats: [str], show_denominators: bool, cite_artifacts: bool, sections: [str]}"
          }
        ],
        "artifacts": [
          "report.md"
        ]
      }
    ],
