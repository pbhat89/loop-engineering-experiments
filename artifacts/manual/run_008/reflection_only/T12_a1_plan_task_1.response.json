{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "split",
      "params": {
        "test_size": 0.25
      }
    },
    {
      "component": "target_definition",
      "params": {
        "amount_column": "paid_amount",
        "percentile": 90,
        "threshold_source": "train_only"
      }
    },
    {
      "component": "feature_set",
      "params": {
        "features": [
          "claim_type",
          "cpt_category",
          "place_of_service",
          "provider_specialty",
          "network_status",
          "service_units",
          "length_of_stay",
          "er_flag",
          "elective_flag",
          "preventive_flag",
          "auth_required_flag",
          "primary_icd10_cm",
          "drg_present",
          "billed_amount",
          "allowed_amount",
          "member_oop",
          "cob_amount"
        ]
      }
    },
    {
      "component": "preprocessing",
      "params": {
        "fit_on": "train_only",
        "scaling": "none"
      }
    },
    {
      "component": "models",
      "params": {
        "models": [
          "logistic_regression",
          "random_forest"
        ]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [
          "class_imbalance",
          "model_limitations"
        ],
        "show_denominators": false,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Plan trains logistic regression and random forest to predict high-cost claims (top 10% by paid amount). Test split of 25% matches task requirement for quarter holdout. Threshold computed on training data only to prevent leakage, with threshold_source=train_only and preprocessing fit_on=train_only. Feature set includes claim-level attributes (claim type, place of service, provider specialty, service units, flags, diagnosis, DRG presence, amounts) while excluding identifiers and target-derived fields. Report includes class imbalance and model limitation caveats and cites artifacts for reproducibility."
}
