{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "claim_volume",
      "params": {
        "by": ["claim_status"],
        "figure": true
      }
    },
    {
      "component": "denial_rate",
      "params": {
        "denominator": "all_claims"
      }
    },
    {
      "component": "fraud_prevalence",
      "params": {
        "denominator": "all_claims"
      }
    },
    {
      "component": "financial_summary",
      "params": {
        "amount_columns": ["billed_amount", "allowed_amount", "paid_amount"],
        "statistics": "sum_mean_quantiles"
      }
    },
    {
      "component": "monthly_trend",
      "params": {
        "date_column": "adjudication_date",
        "metrics": ["claim_count", "paid_amount_sum"]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": ["descriptive_only"],
        "show_denominators": true,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Task requires status breakdown, denial rate, fraud flag prevalence, distributions across billed/allowed/paid amounts, and monthly trends of volume and spend. Plan includes all metric-producing components to populate metrics.json and generate all required artifacts. Report cites sources for transparency to claims leadership."
