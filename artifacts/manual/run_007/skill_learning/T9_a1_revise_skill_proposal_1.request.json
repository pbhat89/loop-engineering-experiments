              "network_status",
              "place_of_service",
              "auth_required_flag"
            ],
            "default": [
              "claim_type"
            ]
          },
          "denominator": {
            "description": "Which claims in each segment form the denominator.",
            "options": [
              "all_claims",
              "adjudicated_claims"
            ],
            "default": "all_claims"
          },
