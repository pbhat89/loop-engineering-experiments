        "denials",
        "denial_codes",
        "rates",
        "denominators",
        "segments",
        "small_groups",
        "place_of_service",
        "network"
      ],
      "input_tables": [
        "medical_claims"
      ],
      "required_artifacts": [
        "denial_code_ranking.csv",
        "denial_rates_by_segment.csv",
        "denial_rate_by_segment.png",
        "report.md",
        "metrics.json"
      ]
    },
