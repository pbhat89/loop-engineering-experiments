      "task_id": "T8",
      "title": "Executive brief",
      "objective": "Write a one-page brief (no more than 600 words) for the head of claims summarising what this piece of work found, using only the saved results of the earlier tasks in this run: the description of the book, the denial analysis, the provider and network comparison and the high-cost model. Cover the key findings, how the model performed, the limitations and what to do next. Produce the standard artifacts (executive brief, findings table, report).",
      "tags": [
        "communication",
        "executive_brief",
        "traceability",
        "caveats",
        "synthesis",
        "limitations"
      ],
      "input_tables": [],
