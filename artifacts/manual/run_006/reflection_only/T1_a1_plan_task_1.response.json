{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "schema_summary"
    },
    {
      "component": "missingness",
      "params": {
        "scope": "all_columns"
      }
    },
    {
      "component": "duplicate_check",
      "params": {
        "keys": [
          "medical_claims.claim_id",
          "pharmacy_claims.rx_claim_id",
          "members.member_id",
          "providers.provider_npi",
          "adherence.member_id+therapeutic_class"
        ]
      }
    },
    {
      "component": "date_ranges",
      "params": {
        "columns": [
          "medical_claims.service_date_from",
          "medical_claims.service_date_to",
          "medical_claims.adjudication_date",
          "pharmacy_claims.fill_date",
          "pharmacy_claims.paid_date",
          "pharmacy_claims.end_date",
          "members.enrollment_start",
          "members.enrollment_end"
        ],
        "consistency_checks": true
      }
    },
    {
      "component": "join_check",
      "params": {
        "pairs": [
          "medical_claims.member_id->members.member_id",
          "medical_claims.rendering_npi->providers.provider_npi",
          "medical_claims.billing_npi->providers.provider_npi",
          "pharmacy_claims.member_id->members.member_id",
          "pharmacy_claims.pharmacy_npi->providers.provider_npi",
          "adherence.member_id->members.member_id"
        ]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [
          "synthetic_data"
        ],
        "show_denominators": true,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Dataset reconnaissance requires thorough validation across structure, quality, identifiability, temporal scope, and relational integrity. This plan loads all five tables, documents schema as data contract, profiles null incidence across all columns to surface completely empty fields, validates primary and composite key uniqueness, examines all date ranges with consistency checks for temporal ordering violations, verifies cardinality and match rates for cross-table relationships, and synthesizes findings into a comprehensive report with denominators and artifact citations."
}
