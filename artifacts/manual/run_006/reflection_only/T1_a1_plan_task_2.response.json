{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "schema_summary"
    },
    {
      "component": "missingness",
      "params": {
        "scope": "all_columns"
      }
    },
    {
      "component": "duplicate_check",
      "params": {
        "keys": [
          "medical_claims.claim_id",
          "pharmacy_claims.rx_claim_id",
          "members.member_id",
          "providers.provider_npi",
          "adherence.member_id+therapeutic_class"
        ]
      }
    },
    {
      "component": "date_ranges",
      "params": {
        "columns": [
          "medical_claims.service_date_from",
          "medical_claims.service_date_to",
          "medical_claims.adjudication_date",
          "pharmacy_claims.fill_date",
          "pharmacy_claims.paid_date",
          "members.enrollment_start",
          "members.enrollment_end"
        ],
        "consistency_checks": true
      }
    },
    {
      "component": "join_check",
      "params": {
        "pairs": [
          "medical_claims.member_id->members.member_id",
          "medical_claims.rendering_npi->providers.provider_npi",
          "medical_claims.billing_npi->providers.provider_npi",
          "pharmacy_claims.member_id->members.member_id",
          "pharmacy_claims.pharmacy_npi->providers.provider_npi",
          "adherence.member_id->members.member_id"
        ]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [
          "descriptive_only"
        ],
        "show_denominators": true,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Complete dataset reconnaissance requires loading all tables, examining their structure and content quality. Missingness scope is set to 'all_columns' to fully map data availability across all fields in all five files. Duplicate checks on all candidate keys verify data integrity of identifiers that enable joining. Date range analysis with consistency checks examines the temporal coverage and logical coherence of date fields across medical and pharmacy claims plus member enrollment. Join checks validate the expected relationships between claims tables, members, providers, and adherence data. The comprehensive report with denominators and artifact citations documents all findings."
}
