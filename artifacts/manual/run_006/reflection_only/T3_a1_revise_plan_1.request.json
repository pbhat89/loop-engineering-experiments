    "task_spec": {
      "task_id": "T3",
      "title": "Provider and network patterns",
      "objective": "Network management wants to know where the money and the denials go. Compare volume, paid amounts, denial rate and fraud-flag rate across provider specialties and between in-network and out-of-network claims. List the ten rendering providers with the most claims, with their specialty and network status taken from the provider directory. Produce the standard artifacts (group comparison table and chart, provider ranking table, report).",
      "tags": [
        "providers",
        "network",
        "specialty",
        "group_comparison",
        "small_groups",
        "rates",
        "denominators",
        "joins",
        "cardinality"
      ],
      "input_tables": [
        "medical_claims",
        "providers"
      ],
      "required_artifacts": [
        "group_comparison.csv",
        "group_comparison.png",
        "provider_ranking.csv",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "load_tables",
        "description": "Load the task's input tables with the project dtype policy and record row and column counts.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "tables",
            "shape": "{table: {rows: int, columns: int}}"
          }
        ]
      },
      {
        "id": "join_check",
        "description": "Cardinality, unmatched keys and row counts for selected cross-table key pairs.",
        "default_selected": false,
        "params": {
          "pairs": {
            "description": "Which left.key->right.key relationships to verify.",
            "multi": true,
            "options": [
              "medical_claims.member_id->members.member_id",
              "medical_claims.rendering_npi->providers.provider_npi",
              "medical_claims.billing_npi->providers.provider_npi",
              "pharmacy_claims.member_id->members.member_id",
              "pharmacy_claims.pharmacy_npi->providers.provider_npi",
              "adherence.member_id->members.member_id"
            ],
            "default": []
          }
        },
        "produces": [
          {
            "key": "join_check",
            "shape": "{pair: {cardinality: str, rows_left: int, rows_after_inner_join: int, unmatched_left: int, unmatched_left_denominator: int, right_key_unique: bool}}"
          }
        ]
      },
      {
        "id": "provider_join",
        "description": "Join medical claims to the provider directory on a chosen provider key and record the row-count change.",
        "default_selected": false,
        "params": {
          "provider_key": {
            "description": "Which claim-level provider id to join on.",
            "options": [
              "rendering_npi",
              "billing_npi"
            ],
            "default": "rendering_npi"
          },
          "how": {
            "description": "Whether to keep only matched claims or all claims.",
            "options": [
              "inner",
              "left"
            ],
            "default": "inner"
          },
          "validate": {
            "description": "Whether to assert a many-to-one relationship during the merge.",
            "options": [
              "none",
              "many_to_one"
            ],
            "default": "none"
          }
        },
        "produces": [
          {
            "key": "provider_join",
            "shape": "{provider_key: str, how: str, validate: str, rows_before: int, rows_after: int, unmatched: int, providers_matched: int}"
          }
        ]
      },
      {
        "id": "group_comparison",
        "description": "Per-group counts, paid totals, denial and fraud rates with small-group flags for chosen grouping columns.",
        "default_selected": true,
        "params": {
          "group_by": {
            "description": "Which claim-level columns (or their combination) define the groups.",
            "multi": true,
            "options": [
              "provider_specialty",
              "network_status",
              "provider_specialty+network_status"
            ],
            "default": [
              "provider_specialty"
            ]
          },
          "metrics": {
            "description": "Which per-group metrics to compute.",
            "multi": true,
            "options": [
              "claim_count",
              "paid_amount_sum",
              "paid_amount_mean",
              "denial_rate",
              "fraud_rate"
            ],
            "default": [
              "claim_count",
              "paid_amount_sum"
            ]
          },
          "denominator": {
            "description": "Which claims in each group form the denial-rate denominator (fraud rate always uses all claims in the group).",
            "options": [
              "all_claims",
              "adjudicated_claims"
            ],
            "default": "all_claims"
          },
          "min_group_size": {
            "description": "Groups with fewer claims than this are flagged as small (0 never flags).",
            "options": [
              0,
              30,
              50,
              100
            ],
            "default": 0
          }
        },
        "produces": [
          {
            "key": "group_comparison",
            "shape": "{min_group_size: int, denominator_option: str, groups: {group_by_key: {group_value: {n: int, claim_count?: int, paid_amount_sum?: float, paid_amount_mean?: float, denial_rate?: {value, numerator, denominator}, fraud_rate?: {value, numerator, denominator}, small_group_flag: bool}}}} (composite values formatted '<specialty>|<network_status>')"
          }
        ],
        "artifacts": [
          "group_comparison.csv",
          "group_comparison.png"
        ]
      },
      {
        "id": "provider_ranking",
        "description": "Top rendering providers by a chosen metric, joined to the provider directory for specialty and network status.",
        "default_selected": false,
        "params": {
          "metric": {
            "description": "Which metric ranks the providers.",
            "options": [
              "claim_count",
              "paid_amount_sum",
              "denial_rate"
            ],
            "default": "claim_count"
          },
          "top_n": {
            "description": "How many providers to list.",
            "options": [
              5,
              10,
              20
            ],
            "default": 10
          },
          "min_claims": {
            "description": "Minimum claims a provider needs to be eligible for the ranking.",
            "options": [
              0,
              30
            ],
            "default": 0
          }
        },
        "produces": [
          {
            "key": "provider_ranking",
            "shape": "{metric: str, top_n: int, min_claims: int, rows: [{provider_npi: str, specialty: str, network_status: str, n: int, value: float}]}"
          }
        ],
        "artifacts": [
          "provider_ranking.csv"
        ]
      },
      {
        "id": "write_report",
        "description": "Write report.md with summary, results, artifacts, caveats and method sections.",
        "default_selected": true,
        "params": {
          "caveats": {
            "description": "Which fixed caveat statements to include in the report's Caveats section.",
            "multi": true,
            "options": [
              "synthetic_data",
              "sample_preview",
              "descriptive_only",
              "association_not_causation",
              "small_groups",
              "class_imbalance",
