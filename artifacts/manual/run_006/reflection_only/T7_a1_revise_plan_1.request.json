            "options": [
              "train_only",
              "all_data"
            ],
            "default": "all_data"
          }
        },
        "produces": [
          {
            "key": "target_definition",
            "shape": "{amount_column: str, percentile: int, threshold_source: str, threshold_value: float, positive_rate_train: float, positive_rate_test: float, n_positive_train: int, n_positive_test: int} (threshold_value = numpy.percentile(values, percentile); positive = amount > threshold_value)"
