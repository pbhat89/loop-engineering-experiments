{
  "steps": [
    {
      "component": "load_tables"
    },
    {
      "component": "split",
      "params": {
        "test_size": 0.25
      }
    },
    {
      "component": "target_definition",
      "params": {
        "amount_column": "paid_amount",
        "percentile": 95,
        "threshold_source": "train_only"
      }
    },
    {
      "component": "feature_set",
      "params": {
        "features": ["claim_type", "cpt_category", "place_of_service", "provider_specialty", "network_status", "service_units", "length_of_stay", "er_flag", "elective_flag", "preventive_flag", "auth_required_flag", "primary_icd10_cm", "billed_amount", "allowed_amount"]
      }
    },
    {
      "component": "preprocessing",
      "params": {
        "fit_on": "train_only",
        "scaling": "none"
      }
    },
    {
      "component": "models",
      "params": {
        "models": ["logistic_regression", "random_forest"]
      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": [],
        "show_denominators": false,
        "cite_artifacts": false
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Split at 0.25 test size as specified. Target is paid amount > 95th percentile, computed on training set to prevent leakage. Feature set includes claim characteristics and cost proxies available at submission time, excluding target and identifiers. Logistic regression for interpretability, random forest for non-linear patterns. Preprocessing with one-hot encoding only (no scaling needed for these models)."
}
