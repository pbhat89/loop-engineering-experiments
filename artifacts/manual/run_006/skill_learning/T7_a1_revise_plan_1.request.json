        {
          "feedback_id": "T7-no_target_leakage",
          "correction": "Remove 'billed_amount' and 'allowed_amount' from feature_set.features. These are post-submission amount fields and constitute target leakage. Use only claim-arrival-time features: claim_type, cpt_category, place_of_service, provider_specialty, network_status, service_units, length_of_stay, er_flag, elective_flag, preventive_flag, auth_required_flag, primary_icd10_cm, drg_present."
        },
