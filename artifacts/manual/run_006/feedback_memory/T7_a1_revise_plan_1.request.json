    "task_spec": {
      "task_id": "T7",
      "title": "High-cost claim identification",
      "objective": "Medical management wants an early-warning model: when a claim comes in, how likely is it to end up among the most expensive 5 percent by paid amount, so a nurse reviewer can look at it early? Hold out a quarter of the claims to test on, define \"high cost\" as paid amount above the 95th percentile, and train a logistic regression plus one tree-based model. Report how well the models rank claims (PR-AUC, ROC-AUC, and precision and recall among the top 5 percent of held-out claims by score). Produce the standard artifacts (model metrics, threshold, feature list, precision-at-k chart, report).",
      "tags": [
        "modeling",
        "high_cost",
        "threshold",
        "percentile",
        "leakage",
        "splits",
        "seeds",
        "ranking",
        "metrics"
      ],
      "input_tables": [
        "medical_claims"
      ],
      "required_artifacts": [
        "model_metrics.json",
        "threshold.json",
        "feature_list.json",
        "precision_at_k.png",
        "report.md",
        "metrics.json"
      ]
    },
