      }
    },
    {
      "component": "write_report",
      "params": {
        "caveats": ["descriptive_only"],
        "show_denominators": true,
        "cite_artifacts": true
      }
    }
  ],
  "skills_applied": [],
  "rationale": "Comprehensive reconnaissance: schema and completeness (all_columns captures fully-null dx3-5 columns and extensive DRG nulls), key uniqueness across all candidate keys including adherence composite, temporal ranges and date-order consistency checks, join verification across all specified pairs. Report with denominators and artifact citations for transparency."
