      "task_id": "T3",
      "title": "Provider and network patterns",
      "objective": "Compare claim count, total and mean paid amount, denial rate and fraud-label rate across provider specialties and across network status, each as its own comparison, using the claim-level specialty and network fields on the medical claims. Show the size of every group and flag groups too small to support a stable rate (fewer than 30 claims). Keep the denial-rate denominator consistent with the portfolio description (claims whose adjudication has concluded) and show numerator and denominator for every rate. Rank the ten rendering providers with the most claims, with their specialty and network status from the provider directory, and verify the join to the provider directory (cardinality and unmatched keys) before relying on it. Present differences between groups as associations, not causes, and state that the data is synthetic.",
      "tags": [
        "providers",
        "network",
        "specialty",
        "group_comparison",
        "small_groups",
        "rates",
        "denominators",
        "joins",
        "cardinality"
      ],
      "input_tables": [
        "medical_claims",
        "providers"
      ],
      "required_artifacts": [
        "group_comparison.csv",
        "group_comparison.png",
        "provider_ranking.csv",
        "report.md",
        "metrics.json"
      ]
    },
