{
  "request_id": "run_001:skill_learning:T1:a1:propose_skill:1",
  "run_id": "run_001",
  "condition": "skill_learning",
  "task_id": "T1",
  "attempt": 1,
  "node": "propose_skill",
  "seq": 1,
  "created_at": "2026-09-06T23:11:53+00:00",
  "instructions": "Turn at most one reusable lesson into a candidate skill following the embedded schema - only if it applies to at least two remaining tasks and does not duplicate an existing skill (existing skills are listed). Procedures must be general, safe (no code execution, network or credentials) and must not restate this task's findings. Otherwise return proposal: null with a reason.",
  "payload": {
    "task_id": "T1",
    "condition": "skill_learning",
    "task_spec": {
      "task_id": "T1",
      "title": "Dataset reconnaissance",
      "objective": "Five synthetic files arrived from the HLT-008 sample: members, providers, medical claims, pharmacy claims and an adherence table. Load each file separately and produce a data contract for every table (row count, column names and types). Profile missingness across every column of every table and call out columns that are entirely empty. Check whether the natural identifier of each table is actually a unique key, including the composite member-plus-therapeutic-class key of the adherence table. Report the range of every date column in the medical claims table and check whether the dates are ordered consistently (for example adjudication happening before the service ended). Verify every cross-file relationship you would rely on later: member ids from each claims table to the members table, the rendering and billing provider ids to the provider directory, and whether pharmacy claims can be joined to the provider directory at all; report cardinality, unmatched keys and row counts. Write a data-quality report that states the data is synthetic and that any value samples shown are previews.",
      "tags": [
        "data_contract",
        "schema",
        "keys",
        "missingness",
        "duplicates",
        "dates",
        "joins",
        "cardinality",
        "data_quality"
      ],
      "input_tables": [
        "members",
        "providers",
        "medical_claims",
        "pharmacy_claims",
        "adherence"
      ],
      "required_artifacts": [
        "data_contract.json",
        "missingness.csv",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "load_tables",
        "description": "Load the task's input tables with the project dtype policy and record row and column counts.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "tables",
            "shape": "{table: {rows: int, columns: int}}"
          }
        ]
      },
      {
        "id": "schema_summary",
        "description": "Column names, dtypes and dtype counts per table, written as the data contract.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "schema",
            "shape": "{table: {rows: int, n_columns: int, dtypes: {dtype: count}}}"
          }
        ],
        "artifacts": [
          "data_contract.json"
        ]
      },
      {
        "id": "missingness",
        "description": "Null counts per column with a list of entirely empty columns per table.",
        "default_selected": true,
        "params": {
          "scope": {
            "description": "Whether to profile only the ten most-null columns per table or every column.",
            "options": [
              "top_10",
              "all_columns"
            ],
            "default": "top_10"
          }
        },
        "produces": [
          {
            "key": "missingness",
            "shape": "{scope: str, per_table: {table: {column: null_count}}, all_null_columns: {table: [column]}}"
          }
        ],
        "artifacts": [
          "missingness.csv"
        ]
      },
      {
        "id": "duplicate_check",
        "description": "Row count versus distinct count for candidate key columns, deciding whether each is a unique key.",
        "default_selected": false,
        "params": {
          "keys": {
            "description": "Which table.column keys (composite keys joined with '+') to test for uniqueness.",
            "multi": true,
            "options": [
              "medical_claims.claim_id",
              "pharmacy_claims.rx_claim_id",
              "members.member_id",
              "providers.provider_npi",
              "adherence.member_id",
              "adherence.member_id+therapeutic_class"
            ],
            "default": [
              "medical_claims.claim_id"
            ]
          }
        },
        "produces": [
          {
            "key": "duplicates",
            "shape": "{key: {n_rows: int, n_unique: int, duplicate_rows: int, is_candidate_key: bool}}"
          }
        ]
      },
      {
        "id": "date_ranges",
        "description": "Minimum, maximum and unparseable count for date columns, optionally with date-order consistency checks.",
        "default_selected": false,
        "params": {
          "columns": {
            "description": "Which table.column date columns to profile.",
            "multi": true,
            "options": [
              "medical_claims.service_date_from",
              "medical_claims.service_date_to",
              "medical_claims.adjudication_date",
              "pharmacy_claims.fill_date",
              "pharmacy_claims.paid_date",
              "members.enrollment_start",
              "members.enrollment_end"
            ],
            "default": [
              "medical_claims.service_date_from"
            ]
          },
          "consistency_checks": {
            "description": "Whether to count medical claims whose adjudication precedes the service end or whose service end precedes its start.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "date_ranges",
            "shape": "{column: {min: 'YYYY-MM-DD', max: 'YYYY-MM-DD', unparseable: int}}"
          },
          {
            "key": "date_consistency",
            "shape": "(only when consistency_checks) {adjudication_before_service_end: int, service_end_before_start: int}"
          }
        ]
      },
      {
        "id": "join_check",
        "description": "Cardinality, unmatched keys and row counts for selected cross-table key pairs.",
        "default_selected": false,
        "params": {
          "pairs": {
            "description": "Which left.key->right.key relationships to verify.",
            "multi": true,
            "options": [
              "medical_claims.member_id->members.member_id",
              "medical_claims.rendering_npi->providers.provider_npi",
              "medical_claims.billing_npi->providers.provider_npi",
              "pharmacy_claims.member_id->members.member_id",
              "pharmacy_claims.pharmacy_npi->providers.provider_npi",
              "adherence.member_id->members.member_id"
            ],
            "default": []
          }
        },
        "produces": [
          {
            "key": "join_check",
            "shape": "{pair: {cardinality: many_to_one|one_to_one|no_match|many_to_many, rows_left: int, rows_after_inner_join: int, unmatched_left: int, unmatched_left_denominator: int, right_key_unique: bool}}"
          }
        ]
      },
      {
        "id": "write_report",
        "description": "Write report.md with summary, results, artifacts, caveats and method sections.",
        "default_selected": true,
        "params": {
          "caveats": {
            "description": "Which fixed caveat statements to include in the report's Caveats section.",
            "multi": true,
            "options": [
              "synthetic_data",
              "sample_preview",
              "descriptive_only",
              "association_not_causation",
              "small_groups",
              "class_imbalance",
              "model_limitations",
              "no_operational_use"
            ],
            "default": []
          },
          "show_denominators": {
            "description": "Whether every rate in the report is printed as numerator / denominator = rate.",
            "options": [
              true,
              false
            ],
            "default": false
          },
          "cite_artifacts": {
            "description": "Whether every results bullet ends with a [source: ...] reference to an artifact or metrics key.",
            "options": [
              true,
              false
            ],
            "default": false
          }
        },
        "produces": [
          {
            "key": "report",
            "shape": "{caveats: [str], show_denominators: bool, cite_artifacts: bool, sections: [str]}"
          }
        ],
        "artifacts": [
          "report.md"
        ]
      }
    ],
