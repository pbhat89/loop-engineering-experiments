      "title": "Claims portfolio description",
      "objective": "The head of claims wants a one-page picture of the medical claims book. How many claims do we have and how do they split by status? What is our denial rate? How common is the fraud flag? What do billed, allowed and paid amounts look like in total and per claim? And how has monthly claim volume moved over time? Produce the standard artifacts (status chart, monthly trend chart and table, financial summary table, report).",
      "tags": [
        "descriptive",
        "portfolio",
        "rates",
        "denominators",
        "financial",
        "trends",
        "status_mix"
      ],
      "input_tables": [
        "medical_claims"
      ],
      "required_artifacts": [
        "claims_status_distribution.png",
        "monthly_claim_volume.png",
        "financial_summary.csv",
        "monthly_trend.csv",
        "report.md",
        "metrics.json"
      ]
    },
