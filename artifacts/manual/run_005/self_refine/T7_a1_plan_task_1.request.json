            "shape": "{fit_on: str, scaling: str, n_features_out: int}"
          }
        ]
      },
      {
        "id": "models",
        "description": "Fit the chosen classifiers and report held-out ranking metrics (top 5 percent of test rows by score).",
        "default_selected": true,
        "params": {
          "models": {
            "description": "Which classifiers to train.",
            "multi": true,
            "options": [
              "logistic_regression",
              "random_forest",
              "gradient_boosting"
            ],
            "default": [
              "logistic_regression"
            ]
          }
        },
        "produces": [
          {
            "key": "models",
            "shape": "{name: {pr_auc: float, roc_auc: float, precision_at_top_5pct: float, recall_at_top_5pct: float, n_test: int}}"
          }
        ],
