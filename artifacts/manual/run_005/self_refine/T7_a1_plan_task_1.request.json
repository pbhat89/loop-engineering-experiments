              "allowed_amount"
            ]
          }
        },
        "produces": [
          {
            "key": "feature_set",
            "shape": "{features: [str], n_categorical: int, n_numeric: int, id_fields_present: [str], target_derived_present: [str]}"
          }
        ],
        "artifacts": [
          "feature_list.json"
        ]
      },
      {
        "id": "preprocessing",
        "description": "One-hot encode categoricals and optionally scale numerics, fitted on a chosen partition.",
        "default_selected": true,
        "params": {
          "fit_on": {
            "description": "Which rows the encoder and scaler are fitted on.",
            "options": [
              "train_only",
              "all_data"
