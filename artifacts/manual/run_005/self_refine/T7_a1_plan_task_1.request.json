  "instructions": "Produce an analysis plan for this task by selecting components from the catalogue and setting their parameters. Use only catalogue component ids and declared parameter options; omitted parameters take their defaults. Deterministic code executes the plan exactly as written, and the result is scored against a frozen rubric (correctness, completeness, reproducibility, statistical discipline, communication) and a frozen golden reference. List in skills_applied the ids of any provided skills you actually used.",
  "payload": {
    "task_id": "T7",
    "condition": "self_refine",
    "task_spec": {
      "task_id": "T7",
      "title": "High-cost claim identification",
      "objective": "Medical management wants an early-warning model: when a claim comes in, how likely is it to end up among the most expensive 5 percent by paid amount, so a nurse reviewer can look at it early? Hold out a quarter of the claims to test on, define \"high cost\" as paid amount above the 95th percentile, and train a logistic regression plus one tree-based model. Report how well the models rank claims (PR-AUC, ROC-AUC, and precision and recall among the top 5 percent of held-out claims by score). Produce the standard artifacts (model metrics, threshold, feature list, precision-at-k chart, report).",
      "tags": [
        "modeling",
        "high_cost",
        "threshold",
        "percentile",
        "leakage",
        "splits",
        "seeds",
        "ranking",
        "metrics"
      ],
      "input_tables": [
        "medical_claims"
      ],
      "required_artifacts": [
        "model_metrics.json",
        "threshold.json",
        "feature_list.json",
        "precision_at_k.png",
        "report.md",
        "metrics.json"
      ]
    },
    "component_catalogue": [
      {
        "id": "load_tables",
        "description": "Load the task's input tables with the project dtype policy and record row and column counts.",
        "default_selected": true,
        "params": {},
        "produces": [
          {
            "key": "tables",
            "shape": "{table: {rows: int, columns: int}}"
          }
        ]
      },
      {
        "id": "split",
        "description": "Plain random train/test split of row indices with the run seed (no stratification; the target is defined afterwards).",
        "default_selected": true,
        "params": {
          "test_size": {
            "description": "Share of rows held out for testing.",
            "options": [
              0.2,
              0.25,
              0.3
            ],
            "default": 0.25
          }
        },
        "produces": [
          {
            "key": "split",
            "shape": "{test_size: float, seed: int, n_train: int, n_test: int}"
          }
        ]
      },
      {
        "id": "target_definition",
        "description": "Define the high-cost target as amount above a percentile threshold computed on a chosen set of rows.",
        "default_selected": true,
        "params": {
          "amount_column": {
            "description": "Which amount column defines cost.",
            "options": [
              "paid_amount",
              "billed_amount",
              "allowed_amount"
            ],
            "default": "paid_amount"
          },
          "percentile": {
            "description": "Which percentile of the amount column sets the threshold.",
            "options": [
              90,
              95,
              99
            ],
            "default": 95
          },
          "threshold_source": {
            "description": "Which rows the percentile is computed on.",
            "options": [
              "train_only",
              "all_data"
            ],
            "default": "all_data"
          }
        },
        "produces": [
          {
            "key": "target_definition",
            "shape": "{amount_column: str, percentile: int, threshold_source: str, threshold_value: float, positive_rate_train: float, positive_rate_test: float, n_positive_train: int, n_positive_test: int} (threshold_value = numpy.percentile(values, percentile); positive = amount > threshold_value)"
          }
        ],
        "artifacts": [
          "threshold.json"
        ]
      },
      {
        "id": "feature_set",
        "description": "Select model features and record which identifier or target-derived fields the selection contains.",
        "default_selected": true,
        "params": {
          "features": {
            "description": "Which columns enter the model as features (drg_present = drg_code.notna()).",
            "multi": true,
            "options": [
              "claim_type",
              "cpt_category",
              "place_of_service",
              "provider_specialty",
              "network_status",
              "service_units",
              "length_of_stay",
