# Environments
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Leftover CSVs under data/raw from deleted work. The experiment's own data pack lives in
# data/underwriting/ and IS committed - it is hash-frozen and must stay in the clone.
data/raw/*.csv

# OS
.DS_Store
Thumbs.db

# LangGraph checkpoint databases. artifacts/uw/<run>/checkpoints/ is what the current
# runner writes and can always rebuild; logs/checkpoints/ holds leftovers from deleted runs.
artifacts/uw/*/checkpoints/
logs/checkpoints/

# Archived LangGraph checkpoint databases (rebuildable; excluded to keep the clone small)
archive/**/checkpoints/
*.sqlite

# Figures redrawn from a run's own logs (the article's committed copies live in articles/)
artifacts/uw/*/figures/

# Tooling caches
.ruff_cache/

# ---------------------------------------------------------------- credentials
# Nothing in this project needs a secret committed. These patterns exist so an
# accidental one is refused by git rather than caught in review.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
*.credentials
credentials.json
client_secret*.json
service-account*.json
.netrc
.npmrc
.pypirc
.aws/
.ssh/
.gnupg/

# Local agent/editor state that can carry account or session identifiers
.claude/settings.local.json
.claude/*.local.*
.claude/sessions/
.claude/shell-snapshots/
.claude/todos/
.vscode/settings.json
.idea/
