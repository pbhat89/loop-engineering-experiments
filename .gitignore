# Environments and secrets
.venv/
.env
*.env.local

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Data: raw/processed files are re-created by src/download_data.py (manifest is committed)
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet

# Binary model artifacts
artifacts/models/*.pkl
artifacts/models/*.joblib

# OS
.DS_Store
Thumbs.db

# LangGraph checkpoint databases (rebuilt by the runner)
logs/checkpoints/
artifacts/uw/*/checkpoints/

# Archived LangGraph checkpoint databases (rebuildable; excluded to keep the clone small)
archive/**/checkpoints/
*.sqlite

# Tooling caches
.ruff_cache/

# ---------------------------------------------------------------- credentials
# Nothing in this project needs a secret committed. These patterns exist so an
# accidental one is refused by git rather than caught in review.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
*.credentials
credentials.json
client_secret*.json
service-account*.json
.netrc
.npmrc
.pypirc
.aws/
.ssh/
.gnupg/

# Local agent/editor state that can carry account or session identifiers
.claude/settings.local.json
.claude/*.local.*
.claude/sessions/
.claude/shell-snapshots/
.claude/todos/
.vscode/settings.json
.idea/
