# Runtime mode for the LangGraph application (docs/LEAD_DESIGN_DECISIONS.md §1):
#   manual         (default) no model calls; LLM-decision nodes pause on an interrupt and a
#                  stateless Claude Code subagent answers via request/response JSON files
#   stub           deterministic fixtures answer the same requests (tests and demos only)
#   anthropic_api  optional, unused in this study; requires ANTHROPIC_API_KEY (separate Console billing)
CLAIMS_SKILL_LOOP_LLM_MODE=manual

# Recorded in every event. Leave empty to use the mode's default
# (manual -> claude-fable-5-1 / claude-code-subagent).
CLAIMS_SKILL_LOOP_MODEL=
CLAIMS_SKILL_LOOP_OPERATOR=

# Only for anthropic_api mode. Never commit a real .env file.
ANTHROPIC_API_KEY=
