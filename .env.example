# Optional. Only needed for live Anthropic API execution (anthropic_api mode).
# Never commit a real .env file.
ANTHROPIC_API_KEY=

# Runtime LLM mode for the LangGraph application:
#   manual_or_stub  (default) deterministic fixtures, no Claude access needed
#   anthropic_api   ChatAnthropic via ANTHROPIC_API_KEY (separate Console billing)
CLAIMS_SKILL_LOOP_LLM_MODE=manual_or_stub

# Model identifier for live modes (leave empty to use the mode's default).
CLAIMS_SKILL_LOOP_MODEL=
